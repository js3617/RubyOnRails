<head>
	<script>
	  function checkLoginAndRedirect() {
		// Assuming user_signed_in? is accessible via a global JS variable or needs to be set inline by ERB
		var loggedIn = <%= user_signed_in? ? 'true' : 'false' %>; // Set the user's login state in a JavaScript variable
		if (!loggedIn) {
		  window.location.href = '<%= new_user_session_path %>'; // Redirect to the login page
		}
	  }
	</script>
</head>

<div class="container mt-5">
  <div class="card">
    <div class="coursecard-body">
      <!-- <h6 class="card-subtitle mb-2 text-muted">가격: <%= @course.price %>원</h6> -->
	  <h1 class="card-title"><%= @course.class_name %></h1>
      <p class="card-info"><%= @course.description %></p>
		<div style="display: flex;">
		  <p class="card-text"><strong>평점</strong>
			  <% if @course.rating.zero? %>
				<% 5.times do %>
				  <span class="fa fa-star" style="color: lightgray;"></span>
				<% end %>
			  <% else %>
				<% @course.rating.times do %>
				  <span class="fa fa-star checked"></span>
				<% end %>
				<% (5 - @course.rating).times do %>
				  <span class="fa fa-star" style="color: lightgray;"></span>
				<% end %>
			  <% end %>
			</p>
			<p class="card-text"><strong>강의수</strong> <%= @course.class_lists.count %>개</p>
		</div>
      <p class="card-text">
			<svg aria-hidden="true" focusable="false" data-prefix="fas" data-icon="user" class="svg-inline--fa fa-user css-uaen9z" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" style="width:14px;color:rgba(255, 255, 255, 0.70)" opacity="0.7">
