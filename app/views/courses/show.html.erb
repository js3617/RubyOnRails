<div class="course_info_main">
	<div class="half">
		<h2>강의 목록</h2>

		<div class="course-list">
		  <% @course.class_lists.order(:created_at).each do |lesson| %>
			<div class="course-item">
			  <div class="course-thumbnail">
				<% if lesson.thumbnail_url.present? %>
				  <% if user_signed_in? %>
					<%= link_to course_class_list_path(@course, lesson) do %>
					  <img src="<%= lesson.thumbnail_url %>" alt="Thumbnail" style="width: 150px; height: auto;">
					<% end %>
				  <% else %>
					<img src="<%= lesson.thumbnail_url %>" alt="Thumbnail" style="width: 150px; height: auto;">
				  <% end %>
				<% else %>
				  <span>썸네일 없음</span>
				<% end %>
			  </div>
			  <div class="course-detail">
				<div class="course-name">
				  <% if user_signed_in? %>
					<%= link_to lesson.lesson_name, course_class_list_path(@course, lesson), class: "text-primary" %>
				  <% else %>
					<%= lesson.lesson_name %>
				  <% end %>
				</div>
				<div class="course-duration">
				  <%= lesson.duration %>
				</div>
				<div class="course-action">
				  <% if user_signed_in? %>
					<% if current_user.take_courses.exists?(course_id: @course.id) %>
					  <%= link_to "강의 보기", course_class_list_path(@course, lesson), class: "btn btn-primary" %>
					<% else %>
					  <span class="btn btn-primary">결제 후 이용 가능</span>
					<% end %>
				  <% else %>
					<span class="btn btn-primary">로그인 후 이용 가능</span>
				  <% end %>
				</div>
			  </div>
			</div>
		  <% end %>
		</div>
		<h2>수강평</h2>
		<div class="courserivew">
		<% if @reviews.present? && @reviews.any? %>
		  <ul class="list-group">
			<% @reviews.each do |review| %>
			  <li class="list-group-item">
				<strong><%= review.user.username %>:</strong>
				<div class="rating-container">
				  <% 5.times do |index| %>
					<% if index < review.rating %>
					  <span class="active-star">★</span>
					<% else %>
					  <span class="inactive-star">☆</span>
					<% end %>
				  <% end %>
				  <p><%= review.rating %></p>
				</div>
				<p><%= review.review %></p>
				<p>좋아요: <%= review.likes_count %></p>

				<!-- 좋아요 버튼 -->
				<% if user_signed_in? %>
				  <% if session["liked_review_#{review.id}"] %>
					<%= button_to "좋아요 취소", unlike_course_review_path(@course, review), method: :delete, remote: true, class: "btn btn-outline-danger btn-sm" %>
				  <% else %>
					<%= button_to "좋아요", like_course_review_path(@course, review), method: :post, remote: true, class: "btn btn-outline-primary btn-sm" %>
				  <% end %>
				<% end %>

				<!-- 대댓글 목록 -->
				<% if review.replies.any? %>
				  <h4>대댓글</h4>
				  <ul class="list-group">
					<% review.replies.each do |reply| %>
					  <li class="list-group-item">
						<strong><%= reply.user.username %>:</strong>
						<p><%= reply.review %></p>
					  </li>
					<% end %>
				  </ul>
				<% end %>

				<!-- 대댓글 작성 -->
				<% if user_signed_in? %>
				  <%= form_with url: reply_course_review_path(@course, review), method: :post, local: true do |f| %>
					<div class="form-group">
					  <%= f.text_area :review, placeholder: "대댓글 작성", required: true, class: "form-control" %>
					  <%= f.submit "작성", class: "btn btn-secondary mt-2" %>
					</div>
				  <% end %>
				<% end %>
			  </li>
			<% end %>
		  </ul>
		<% else %>
		  <p style="color: #212529; font-size: 1rem;">등록된 수강평이 없습니다.</p>
		<% end %>

		<!-- 수강평 작성 -->
			<div class="coursesub">
				<% if user_signed_in? && current_user.take_courses.exists?(course_id: @course.id) %>
				  <h3>수강평 작성</h3>
				  <%= form_with model: @review, url: course_reviews_path(@course), method: :post, local: true do |f| %>
					<div class="form-group" style=" display: flex; gap:10px; margin-bottom: 20px; ">
					  <%= f.label :rating, "평점:" %>
					  <%= f.number_field :rating, min: 1, max: 5, required: true, class: "form-control" %>
					</div>
					<div class="form-group">
					  <%= f.label :review, "수강평" %>
					  <%= f.text_area :review, required: true, class: "form-control" %>
					</div>
					<div class="btnwrapper">
						<%= f.submit "등록", class: "registrationbtn btn-success mt-2" %>
					</div>
				  <% end %>
				<% else %>
				  <p style="display:flex;color: #adb5bd; font-size: 0.875rem;justify-content: center; align-items: center;">수강평을 작성하려면 강의를 수강해야 합니다.</p>
				<% end %>
			</div>
		</div>
	</div>
