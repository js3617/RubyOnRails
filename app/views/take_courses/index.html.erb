			<% if @take_courses.any? %>
			<ul class="mycourseinfo">
				<% @take_courses.each do |take_course| %>
				 <li>
					<% if take_course.course.thumbnail_url.present? %>
					  	<%= link_to course_path(take_course.course) do %>
							<%= image_tag(take_course.course.thumbnail_url, alt: "#{take_course.course.class_name} Thumbnail", class: "mycourse-thumbnail") %>
					  	<% end %>
						<% else %>
					  	<%= link_to course_path(take_course.course) do %>
							<%= image_tag("default_thumbnail.png", alt: "Default Thumbnail", class: "course-thumbnail") %>
						<% end %>
					<% end %>
					<p class="mycoursetext"><%= link_to take_course.course.class_name, course_path(take_course.course.id) %></p>
					<div class="mantine-Progress-root mantine-xjutu9"><div role="progressbar" aria-valuemax="100" aria-valuemin="0" aria-valuenow="1.22" aria-label="진도율" class="mantine-r8gj5s mantine-Progress-bar" style="width: 1.22%;"></div></div>
					<div class="mantine-wfw6r2">
						<div class="mantine-Stack-root css-1max160 mantine-jo24o3">
							<div class="mantine-mhdxd6">
								<span class="mantine-Text-root mantine-1cuc0qu">1</span>
								<span class="mantine-Text-root mantine-1coc85u">/ <%= @total_lectures %>강</span>
								<span class="mantine-Text-root mantine-1coc85u">(1.22%)</span>
							</div><p class="mantine-Text-root mantine-6274m">무제한</p>
						</div>
					 </div>
					<p>수강 시작일 <%= take_course.start_date.strftime('%Y-%m-%d %H:%M') %></p>
				</li>
				<% end %>
			</ul>
			<% else %>
			    <p>현재 수강 중인 강의가 없습니다.</p>
