<h2>회원가입</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  
  <div class="field">
    <%= f.label :username, "실명" %><br />
    <%= f.text_field :username, autocomplete: "username"%>
  </div>

  <div class="field">
	  <%= f.label :이메일 %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "이메일"%>
  </div>

  <div class="field">
    <%= f.label :비밀번호 %>
    <%= f.password_field :password, autocomplete: "new-password", placeholder: "******" %>
  	<% if @minimum_password_length %>
    	<em><%= @minimum_password_length %>자 이상 32자 이하 입력 (공백 제외)</em>
    <% end %><br />
  </div>

  <div class="field">
    <%= f.label :비밀번호확인 %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "******" %>
  </div>

  <div class="actions">
    <%= f.submit "가입하기", class: "loginbtn"%>
  </div>
<% end %>
<div>
	<p>
		해당 계정은 통합 계정으로 인프런과 랠릿에서 제공하는 서비스를 모두 이용하실 수 있습니다. 가입 시, 통합 계정 및 서비스 이용약관 (인프런 / 랠릿), 개인정보처리 방침에 동의하는 것으로 간주합니다.
	</p>
</div>

<div>
  <h3>간편 회원가입</h3>
  <%= link_to "Sign up with Google", user_google_oauth2_omniauth_authorize_path, class: "btn btn-danger" %><br />
  <%= link_to "Sign up with Kakao", user_kakao_omniauth_authorize_path, class: "btn btn-warning" %>
</div>

<%= render "devise/shared/links" %>
