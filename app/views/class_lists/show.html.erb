<h2><%= @class_list.lesson_name %></h2>
<p><%= @class_list.description %></p>

<div class="youtube-player">
  <iframe
    width="100%"
    height="400"
    src="https://www.youtube.com/embed/<%= @class_list.youtube_video_id %>"
    title="<%= @class_list.lesson_name %>"
    frameborder="0"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen>
  </iframe>
</div>

<p>
  <strong>영상 길이:</strong>
  <%= @class_list.duration %>
</p>

<%= link_to "뒤로 가기", course_path(@course), class: "btn btn-secondary" %>
