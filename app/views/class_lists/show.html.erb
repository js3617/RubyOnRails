<script>
document.addEventListener('DOMContentLoaded', function() {
  var curriculumButton = document.getElementById('curriculumButton');
  var curriculumContent = document.getElementById('curriculumContent');

  curriculumButton.addEventListener('click', function() {
    var isDisplayed = curriculumContent.style.display === 'block';
