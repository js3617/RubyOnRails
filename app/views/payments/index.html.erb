<div class="containers">
  <div class="row" style="padding: 0 0 0 40px;">
    <div class="col-12 mt-5">
      <h2 class="text-center">구매내역</h2>
    </div>
  </div>
  <div class="row">
    <div class="col-12" style="width: 100%;">
      <% if @payments.empty? %>
        <div class="alert alert-info" role="alert">
          구매 내역이 없습니다.
        </div>
      <% else %>
		<% @payments.each do |payment| %>
		<div class="dayinfo">
			<div>주문 날짜 <strong><%= payment.created_at.strftime("%Y.%m.%d") %></strong></div>
			<div><a href="/payments/<%= payment.id %>" class="btn btn-primary">상세 보기 ></a></div>
		</div>
        <div class="payment-detail">
            <div class="payment-item">
				<div class="numst">
				  <div><span class="status-badge"><%= payment.status %></span></div>
				  <div>주문 번호 <strong><%= payment.id %></strong></div>
				</div>
              <div><%= payment.payment_items.map { |item| item.course&.class_name || "알 수 없는 항목" }.join(", ") %></div>
              <div><strong>결제 금액:</strong> <%= number_to_currency(payment.amount, unit: "₩", precision: 0) %></div>
            </div>
			
			<div class="payment-item" style="width: 230px;">
              <div style="display: flex;justify-content: space-between;"><strong>금액</strong> <%= number_to_currency(payment.amount, unit: "₩", precision: 0) %></div>
			  <div style="display: flex;justify-content: end; border-bottom: 1px solid #ddd;"><%= number_to_currency(payment.amount, unit: "₩", precision: 0) %></div>
			  <div style="display: flex;justify-content: space-between;"><strong>합계</strong> <%= number_to_currency(payment.amount, unit: "₩", precision: 0) %></div>
            </div>
			
			<div class="payment-item">
              <div class="receipt">영수증</div>
			  <div class="specification">거래명세서</div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
</div>
