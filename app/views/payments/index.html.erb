<div class="containers">
  <div class="row">
    <div class="col-12 mt-5">
      <h2 class="text-center">결제내역</h2>
      <div class="alert alert-primary mt-4" role="alert">
        일반구매 내역이 표시됩니다. <br>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-12">
      <table class="table">
        <thead>
          <tr class="table-info">
            <th scope="col">주문 번호</th>
            <th scope="col">주문 일시</th>
            <th scope="col">결제 항목</th>
            <th scope="col">결제 금액</th>
            <th scope="col">주문 상태</th>
            <th scope="col">상세보기</th>
          </tr>
        </thead>
        <tbody>
          <% @payments.each do |payment| %>
            <tr>
              <td><%= payment.id %></td>
              <td><%= payment.created_at.strftime("%F") %></td>
              <td>
                <% if payment.payment_items.any? %>
                  <% payment.payment_items.each do |item| %>
                    <p><%= item.course&.class_name || "알 수 없는 항목" %></p>
                  <% end %>
                <% else %>
                  <p>결제 항목이 없습니다.</p>
                <% end %>
              </td>
              <td><%= number_to_currency(payment.amount, unit: "₩", precision: 0) %></td>
              <td><span class="badge badge-warning"><%= payment.status %></span></td>
              <td><a href="/payments/<%= payment.id %>" class="btn btn-primary">상세 보기</a></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
