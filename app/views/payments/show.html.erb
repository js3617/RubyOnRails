<div class="content">
	<h1>구매 상세 정보</h1>
	<p>구매하신 강의의 상세 정보를 확인해 보세요.</p>
	<div class="info">
		<div class="paycards">
			<div class="paycardheader">
				<p>구매한 강의 수 <%= @payment.payment_items.count %>개</p>
				<button class="cancle">전체 취소</button>
			</div>
			<% if @payment.payment_items.any? %>
			<div class="paybody">
				<% @payment.payment_items.each do |item| %>
            	<% if item.course.present? %>
				<div class="courscard">
					<div class="courinfoimg">
						<% if item.course.thumbnail_url.present? %>
						  <%= image_tag(item.course.thumbnail_url, alt: "#{item.course.class_name} Thumbnail") %>
						<% else %>
						  <%= image_tag('default_thumbnail.png', alt: "Default Thumbnail") %>
						<% end %>
					</div>
					<div class="courinfo">
						<p><%= link_to item.course.class_name, course_path(item.course) %></p>
						<p><%= number_to_currency(item.course.price, unit: "₩", precision: 0) %></p>
					</div>
					<div>
						<button class="cancle">취소</button>
					</div>
				</div>
				<% end %>
          		<% end %>
			</div>
			<% end %>
		</div>

		<div class="paycard">
			<div class="paycard-summary">
				<div class="summary-row">
					<span class="label negative">총 결제 금액</span>
					<span class="value negative"><%= number_to_currency(@payment.amount, unit: "₩", precision: 0) %></span>
				</div>
				<% total_course_price = @payment.payment_items.sum { |item| item.course.price } %>
				<div class="summary-row">
					<span class="label">강의 금액</span>
					<span class="value"><%= number_to_currency(total_course_price, unit: "₩", precision: 0) %></span>
				</div>
				<% discount_amount = total_course_price - @payment.amount %>
				<div class="summary-row">
					<span class="label">할인 금액</span>
					<span class="value"><%= number_to_currency(discount_amount, unit: "₩", precision: 0) %></span>
				</div>
				<hr>
				<div class="summary-row">
					<span class="label">상태</span>
					<span class="status"><%= @payment.status == 'completed' ? '결제 완료' : @payment.status %></span>
				</div>
				<div class="summary-row">
					<span class="label">결제 수단</span>
					<span class="method"><%= @payment.payment_method %></span>
				</div>
				<div class="summary-row">
					<span class="label">결제 시각</span>
					<span class="time"><%= @payment.created_at.strftime('%Y.%m.%d. %H:%M (%Z)') %></span>
				</div>
				<hr>
				<div class="summary-row">
					<button class="cancle">거래명세서</button>
				</div>
			</div>
		</div>
		
		
	</div>
</div>
