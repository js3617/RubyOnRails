					<div style="display: flex; justify-content: space-between;">
					  <strong>총 결제 금액</strong> <span id="total-price">0</span>
					</div>
					<% if @basket_courses.any? { |basket| basket.course.price > 0 } %>
					<!-- 유료 강의가 포함된 경우 -->
					<button type="button" onclick="request_pay()" class="btn-cashe">결제하기</button>
				  <% else %>
					<!-- 모든 강의가 무료인 경우 -->
					<%= form_with url: payments_path, method: :post, id: "free_checkout_form" do %>
					  <input type="hidden" name="selected_basket_ids[]" value="<%= @basket_courses.map(&:id).join(',') %>">
					  <%= submit_tag "무료 결제 완료하기", class: "btn btn-success" %>
