<div class="maincontent">
	<div class="cartcontainer">
		<div class="bbdt">
			<div class="rightcart">
				<h1>수강바구니</h1>

				<div class="cartcheck">
				<% if @basket_courses.present? && @basket_courses.any? %>
					<%= hidden_field_tag :authenticity_token, form_authenticity_token %>
					<!-- 전체 선택 체크박스 -->
					<ul>
						<div class="allcheck">
							<div style="margin-bottom: 10px; display: flex;">
						  		<input type="checkbox" id="select-all" class="select-all">
						  		<label for="select-all">전체 선택</label>
						  	</div>
						</div>
					  <% @basket_courses.each do |basket| %>
						<% if basket.course.present? %>
						  <li>
							  <div class="chcode">
								  <div class="flexc">
								  <!-- 썸네일 -->
								  <div style="display: flex; gap: 15px;">
									  <!-- 체크박스 -->
									<div>
									  <%= check_box_tag "selected_basket_ids[]", basket.id, false, class: "basket-checkbox", data: { price: basket.course.price } %>
									</div>
									<% if basket.course.thumbnail_url.present? %>
									  <%= image_tag basket.course.thumbnail_url, alt: "Thumbnail", class: "course-thumbnail" %>
									<% else %>
									  <p>이미지 없음</p>
									<% end %>
									  <!-- 강의 정보 -->
									<div>
									  <h3>
										<%= link_to basket.course.class_name, course_path(basket.course), class: "linkthumnail" %>
									  </h3>
										<p class="thumtext">Basket ID: <%= basket.id %> |
									  Course ID: <%= basket.course.id %></p>
									</div>
								  </div>
									<!-- 삭제 버튼 -->
									<div style="margin-right: 10px;">
									  <%= button_to basket_path(basket.id), method: :delete, data: { confirm: '해당 강의를 수강바구니에서 삭제하시겠습니까?' }, class: 'btn btn-danger delete-icon' do %>
										X
									  <% end %>
									</div>
								  </div>
								  <p class="pay"><%= number_to_currency(basket.course.price, unit: "₩", precision: 0) %></p>
							  </div>
						  </li>
						  <hr>
						<% else %>
						  <li>
							<p>강의 정보를 찾을 수 없습니다.</p>
						  </li>
						<% end %>
					  <% end %>
					</ul>		
				</div>
			</div>

			<div class="leftcart">
				<!-- 결제 폼 (숨겨진 필드 포함) -->
				<input type="hidden" name="imp_uid" id="imp_uid">
				<input type="hidden" name="merchant_uid" id="merchant_uid">
				<input type="hidden" name="paid_amount" id="paid_amount">
				<input type="hidden" name="apply_num" id="apply_num">
				<input type="hidden" name="error_msg" id="error_msg">

				<!-- 결제 버튼 -->
				<div class="paycard">
