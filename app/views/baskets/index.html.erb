				</div>
			  </div>
			<% else %>
			  <p>수강바구니에 담긴 강의가 없습니다.</p>
			<% end %>
		</div>
	</div>
</div>
<!-- PortOne 결제 요청 스크립트 -->
<script src="https://cdn.iamport.kr/v1/iamport.js"></script>
<script>
  function request_pay() {
    const IMP = window.IMP; // PortOne SDK 객체
    const merchantCode = "<%= ENV['PORTONE_MERCHANT_CODE'] || 'imp25246564' %>"; // 가맹점 코드
    IMP.init(merchantCode);
  
    // 선택된 강의 ID 확인 로직
    const selectedBaskets = Array.from(
      document.querySelectorAll('input[name="selected_basket_ids[]"]:checked')
    ).map(input => input.value);

    if (selectedBaskets.length === 0) {
      alert("결제할 강의를 선택해주세요.");
      return;
    }

    // 선택된 강의명 추출
    const selectedCourses = selectedBaskets.map(id => {
      const courseNameElement = document.querySelector(`input[value="${id}"]`)
        .closest('li')
        .querySelector('h3 a');
      return courseNameElement.textContent.trim();
    });

    // 강의명 형식 설정 ('강의명 등 2개' 형식)
    let courseNames = selectedCourses.join(", ");
    if (selectedCourses.length > 1) {
      courseNames = `${selectedCourses[0]} 등 ${selectedCourses.length}개`;
    }

    // 총 결제 금액 계산
    const totalAmount = selectedBaskets.reduce((sum, id) => {
      const priceElement = document.querySelector(`input[value="${id}"]`)
        .closest('li')
        .querySelector('.pay');
      const priceText = priceElement.textContent.replace(/[^0-9]/g, '');
      return sum + parseInt(priceText, 10);
    }, 0);
	  
	// 0원 강의 처리
    if (totalAmount === 0) {
      fetch('<%= payments_path %>', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({
          selected_basket_ids: selectedBaskets,
          paid_amount: totalAmount,
          pay_method: "free",
          pg_provider: "none"
        })
      })
      .then(response => response.json())
      .then(data => {
        if (data.status === 'completed') {
          alert('무료 결제가 성공적으로 완료되었습니다.');
          window.location.href = `/payments/${data.payment_id}`;
        } else {
          alert('무료 결제가 처리되지 않았습니다: ' + data.message);
        }
      });
      return;
    }
	
    // 결제 요청	
    IMP.request_pay({
	  pg: 'html5_inicis', // PG사
	  pay_method: 'card', // 결제수단
	  merchant_uid: 'merchant_' + new Date().getTime(), // 고유 주문번호
	  name: courseNames, // 선택된 강의명
	  amount: totalAmount, // 총 결제 금액
	  buyer_email: '<%= current_user.email %>', // 사용자 이메일
	}, function (rsp) {
	  if (rsp.success) {
		// 서버로 데이터 전송
		fetch('<%= payments_path %>', {
		  method: 'POST',
		  headers: {
			'Content-Type': 'application/json',
			'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
		  },
		  body: JSON.stringify({
			imp_uid: rsp.imp_uid, // PortOne 거래 ID
			paid_amount: rsp.paid_amount, // 결제 금액
			pay_method: rsp.pay_method, // 결제 수단
			pg_provider: rsp.pg_provider, // PG사 정보
			selected_basket_ids: selectedBaskets // 선택된 바구니 ID
		  })
		})
		.then(response => response.json())
		.then(data => {
		  if (data.status === 'completed') {
			alert('결제가 성공적으로 완료되었습니다.');
			window.location.href = `/payments/${data.payment_id}`; // 결제 상세 페이지로 이동
		  } else {
			alert('결제가 처리되지 않았습니다: ' + data.message);
		  }
		});
	  } else {
		alert('결제에 실패하였습니다. 사유: ' + rsp.error_msg);
	  }
	});
  }
	  
   document.addEventListener('DOMContentLoaded', function() {
    const totalPriceElement = document.getElementById('total-price');
    const selectAllCheckbox = document.querySelector('#select-all');
    const checkboxes = document.querySelectorAll('.basket-checkbox');

    function updateTotalPrice() {
        let total = 0;
        checkboxes.forEach(checkbox => {
            if (checkbox.checked) {
                total += parseInt(checkbox.dataset.price, 10);
            }
        });
        totalPriceElement.textContent = '₩' + total.toLocaleString();
    }

    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            updateTotalPrice();
            // 전체 선택 상태 확인 및 처리
            selectAllCheckbox.checked = checkboxes.length === document.querySelectorAll('.basket-checkbox:checked').length;
        });
    });

    selectAllCheckbox.addEventListener('change', function() {
        checkboxes.forEach(checkbox => {
            checkbox.checked = this.checked;
        });
        updateTotalPrice();
    });

    updateTotalPrice(); // 페이지 로드 시 초기 가격 업데이트
});

</script>
